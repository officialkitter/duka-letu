# Railway injects PORT automatically.
PORT=3000
NODE_ENV=production

# Comma-separated list of allowed browser origins (your Vercel domains).
WEB_ORIGINS=https://your-pos.vercel.app,http://localhost:3000

# Supabase Postgres. Use the Supavisor *session* pooler string (IPv4-friendly,
# works with SET LOCAL / transactions) or the direct string if Railway has IPv6.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# JWT verification. Provide ONE of the two:
SUPABASE_URL=https://<project-ref>.supabase.co
# (a) projects using the legacy shared secret (HS256):
SUPABASE_JWT_SECRET=
# (b) projects using asymmetric signing keys:
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Stripe (platform account; tenant_id is stamped into PaymentIntent metadata)
STRIPE_SECRET_KEY=sk_test_...
# Terminal Location the readers are registered to (tml_...)
STRIPE_TERMINAL_LOCATION_ID=tml_...
