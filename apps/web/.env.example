# --- Demo mode (no Supabase) ---------------------------------------------------
# Leave NEXT_PUBLIC_SUPABASE_URL unset (or set NEXT_PUBLIC_MOCK_MODE=true) to run on mock data.
# Sign in with owner|manager|cashier@dukaletu.test / demo1234.
# With no NEXT_PUBLIC_API_URL everything is answered in the browser; to use the mock API
# run `npm run dev:mock` in apps/api and set NEXT_PUBLIC_API_URL=http://localhost:8787
# NEXT_PUBLIC_MOCK_MODE=true

# --- Real backend ---------------------------------------------------------------
# Public values only. Nothing secret belongs in the web app.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# Railway URL of apps/api (no trailing slash)
NEXT_PUBLIC_API_URL=https://your-api.up.railway.app

# true => Stripe Terminal simulated reader (test mode only)
NEXT_PUBLIC_STRIPE_SIMULATED=true
