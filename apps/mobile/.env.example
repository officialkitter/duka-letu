# --- Demo mode (no Supabase) ---------------------------------------------------
# Leave the Supabase values unset (or set EXPO_PUBLIC_MOCK_MODE=true) to run on mock data.
# Sign in with owner|manager|cashier@dukaletu.test / demo1234.
# Without EXPO_PUBLIC_API_URL sync is answered on the device; to use the mock API run
# `npm run dev:mock` in apps/api and set EXPO_PUBLIC_API_URL=http://<your-pc-ip>:8787
# EXPO_PUBLIC_MOCK_MODE=true

# --- Real backend ----------------------------------------------------------------
# Public client configuration only. Never put service-role or Stripe secret keys here.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>
EXPO_PUBLIC_API_URL=https://your-api.up.railway.app
